{
  "name": "earthquake-tracker-siesquen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks": "husky"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "oxlint --deny-warnings"
    ],
    "*.{css,json,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
