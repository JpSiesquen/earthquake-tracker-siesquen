{
  "name": "earthquake-tracker-siesquen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks": "husky",
    "test:usgs-schema": "node --experimental-strip-types scripts/check-usgs-schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "maplibre-gl": "5.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "oxlint --deny-warnings"
    ],
    "*.{css,json,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
